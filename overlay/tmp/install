#!/usr/bin/nu

use bf

# Setup and install Unbound
def main [] {
    # add Unbound user
    bf user add unbound

    # Unbound is copied from the bfren-bin/unbound image - install the libraries it needs and the DNSSEC root trust anchor
    cd /tmp
    let version = bf fs read UNBOUND_REVISION
    bf write $"Installing libraries for Unbound v($version)."
    bf pkg install [dnssec-root libcrypto3 libevent libexpat libssl3 nghttp2-libs]

    # save Unbound version to build log
    bf build add Unbound $version

    # download latest root.hints file
    bf http download "https://www.internic.net/domain/named.root" "/etc/unbound/root.hints"

    # install additional packages
    bf write "Installing additional packages."
    bf pkg install [drill]

    # add bf-unbound module to config
    bf config use_mod bf-unbound
}
